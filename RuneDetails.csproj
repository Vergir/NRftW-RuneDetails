<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RuneDetails</AssemblyName>
    <RootNamespace>RuneDetails</RootNamespace>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>
    <!-- Game install. Override with: dotnet build -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Games\Steam\steamapps\common\NoRestForTheWicked</GameDir>
    <MLDir>$(GameDir)\MelonLoader\net6</MLDir>
    <InteropDir>$(GameDir)\MelonLoader\Il2CppAssemblies</InteropDir>
    <!-- Copy the built DLL into the game's Mods folder after each build (-p:DeployToGame=false to skip). -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader runtime -->
    <Reference Include="MelonLoader"><HintPath>$(MLDir)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MLDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(MLDir)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <!-- Generated interop assemblies (created by MelonLoader on first game launch) -->
    <Reference Include="Il2Cppmscorlib"><HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cpp__forsaken"><HintPath>$(InteropDir)\Il2Cpp__forsaken.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(InteropDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(InteropDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppQuantum.Engine"><HintPath>$(InteropDir)\Il2CppQuantum.Engine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppQuantum.Deterministic"><HintPath>$(InteropDir)\Il2CppQuantum.Deterministic.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmoon.quantum.forsaken"><HintPath>$(InteropDir)\Il2Cppmoon.quantum.forsaken.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!--
    Deploy to <game>/Mods. MelonLoader HotReload loads Mods/ from shadow copies, so the files there are never locked and
    a plain copy works while the game runs; HotReload picks the new build up.
  -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' And Exists('$(GameDir)\Mods')">
    <ItemGroup>
      <_DeployFile Include="$(TargetPath);$(TargetDir)$(TargetName).pdb" />
      <_DeployFile Remove="@(_DeployFile)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFile)" DestinationFolder="$(GameDir)\Mods" Retries="3" RetryDelayMilliseconds="300" ContinueOnError="true" />
    <Message Importance="high" Text="$(TargetFileName) -> $(GameDir)\Mods" />
  </Target>

  <!--
    src/Shared/SettingsRowsKit.cs is a vendored copy of the workspace's canonical ../Shared/SettingsRowsKit.cs
    (../Shared/sync-shared.ps1 copies it in). Warn when they differ; a clone without ../Shared builds silently.
  -->
  <Target Name="CheckSharedKit" BeforeTargets="CoreCompile" Condition="Exists('$(MSBuildProjectDirectory)\..\Shared\SettingsRowsKit.cs')">
    <PropertyGroup>
      <_SharedKitCanonical>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\Shared\SettingsRowsKit.cs').Replace('&#13;', ''))</_SharedKitCanonical>
      <_SharedKitVendored Condition="Exists('$(MSBuildProjectDirectory)\src\Shared\SettingsRowsKit.cs')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\src\Shared\SettingsRowsKit.cs').Replace('&#13;', ''))</_SharedKitVendored>
    </PropertyGroup>
    <Warning Condition="'$(_SharedKitCanonical)' != '$(_SharedKitVendored)'" Code="SHAREDKIT"
             Text="src/Shared/SettingsRowsKit.cs differs from the canonical ../Shared/SettingsRowsKit.cs: move the change there and run ../Shared/sync-shared.ps1." />
  </Target>

</Project>
